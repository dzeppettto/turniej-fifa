<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GRZYBOWIT FIFA CUP</title>
<link rel="stylesheet" href="styles.css">
</head>
<body>
<div class="bg"></div>

<!-- STRONA STARTOWA -->
<div id="intro" class="intro">
  <div class="intro-box">
    <div class="intro-logo">🏆</div>
    <h1 class="intro-title">GRZYBOWIT <span>FIFA CUP</span></h1>
    <p class="intro-sub">Mecze · tabele · drabinki · statystyki graczy</p>
    <div class="intro-actions">
      <button id="introNew" class="btn btn-gold">▶️ Zacznij nowy turniej</button>
      <button id="introStats" class="btn">📊 Statystyki i historia</button>
      <button id="introSync" class="btn">🌐 Współdzielone wyniki</button>
      <button id="introContinue" class="btn btn-ghost">↩️ Wróć do bieżącego turnieju</button>
    </div>
  </div>
</div>

<header class="topbar">
  <div class="brand">
    <div class="logo">🏆</div>
    <div>
      <h1><span id="brandGame">FIFA 15</span> <span class="date" id="brandDate">13.10.2026</span></h1>
      <p class="sub" id="tourSub">—</p>
    </div>
  </div>
  <div class="top-actions">
    <button id="syncChip" class="sync-chip" type="button" title="Współdzielone wyniki online">
      <span class="sync-dot off"></span><span id="syncChipText">Lokalnie</span>
    </button>
    <select id="tourSelect" class="select" title="Wybierz turniej"></select>
    <button id="btnNewTour" class="btn">➕ Nowy turniej</button>
    <button id="btnDraw" class="btn btn-gold">🎲 Losuj rewanże</button>
  </div>
</header>

<nav class="tabs">
  <button class="tab active" data-tab="kolejki">📅 Kolejki</button>
  <button class="tab" data-tab="tabela">📊 Tabela</button>
  <button class="tab" data-tab="drabinka">🏆 Drabinka</button>
</nav>

<main>
  <!-- KOLEJKI -->
  <section id="kolejki" class="panel active">
    <div class="col2">
      <div class="card">
        <h2>Kolejka 1 <span class="badge">faza zasadnicza</span></h2>
        <div id="round1Header" class="round2-header"></div>
        <div id="round1List" class="matches"></div>
      </div>
      <div class="card">
        <h2>Kolejka 2 <span class="badge badge-red">rewanże</span></h2>
        <div id="round2Header" class="round2-header"></div>
        <div id="round2List" class="matches"></div>
      </div>
    </div>
  </section>

  <!-- TABELA -->
  <section id="tabela" class="panel">
    <div class="card">
      <h2>📊 Tabela turnieju <span class="badge" id="tblName"></span></h2>
      <div class="table-wrap">
        <table class="standings">
          <thead>
            <tr>
              <th>#</th><th>Zawodnik</th><th>M</th><th>Z</th><th>R</th><th>P</th>
              <th>Bramki</th><th>Bilans</th><th>Pkt</th>
            </tr>
          </thead>
          <tbody id="standingsBody"></tbody>
        </table>
      </div>
      <p class="note">Zwycięstwo 3 pkt · Remis 1 pkt · Porażka 0 pkt · Kryteria: pkt → bilans → bezpośrednie mecze (H2H) → bramki zdobyte.</p>
    </div>
  </section>

  <!-- DRABINKA -->
  <section id="drabinka" class="panel">
    <div class="card">
      <h2>🏆 Faza pucharowa <span class="badge" id="brName"></span></h2>
      <div class="bracket">
        <div class="bracket-col">
          <h3>Kolejka 1</h3>
          <div id="bracketR1" class="bracket-matches"></div>
        </div>
        <div class="bracket-col">
          <h3>Rewanże</h3>
          <div id="bracketR2" class="bracket-matches"></div>
        </div>
        <div class="bracket-col">
          <h3>🏆 FINAŁ (1 vs 2)</h3>
          <div id="bracketFinal" class="bracket-matches"></div>
          <h3 style="margin-top:14px">🥉 Mecz o 3. miejsce</h3>
          <div id="bracketThird" class="bracket-matches"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- GRACZE i TURNIEJE przeniesione do osobnego ekranu (#historyScreen) -->
</main>

<!-- EKRAN STATYSTYK I HISTORII (dostępny tylko ze strony startowej) -->
<div id="historyScreen" class="history hidden">
  <div class="history-bar">
    <h2>📊 Statystyki i historia</h2>
    <button id="btnHistoryBack" class="btn btn-ghost">↩️ Wróć do ekranu startowego</button>
  </div>
  <div class="history-body">

    <section id="gracze" class="hist-section">
      <div class="card">
        <h2>👤 Ranking graczy <span class="badge" id="pgBadge"></span></h2>
        <div class="filter-row">
          <label>Gra:
            <select id="pgFilter" class="select"></select>
          </label>
          <span class="note" id="pgCount"></span>
        </div>
        <div class="table-wrap">
          <table class="standings">
            <thead>
              <tr>
                <th>#</th><th>Zawodnik</th><th>Turnieje</th><th>Tytuły</th><th>M</th>
                <th>Z</th><th>R</th><th>P</th><th>Bramki</th><th>Bilans</th><th>Pkt</th>
                <th>%Z</th><th>Śr.br.</th>
              </tr>
            </thead>
            <tbody id="playersBody"></tbody>
          </table>
        </div>
        <p class="note">Kliknij zawodnika, aby zobaczyć kartę profilu. Bilans liczony ze wszystkich meczów (liga + faza pucharowa).</p>
      </div>

      <div class="card" style="margin-top:18px">
        <h2>🎮 Bilans per gra (Z-R-P)</h2>
        <div class="table-wrap">
          <table class="standings">
            <thead id="perGameHead"></thead>
            <tbody id="perGameBody"></tbody>
          </table>
        </div>
      </div>

      <div class="card" style="margin-top:18px">
        <h2>⚔️ Bezpośrednie mecze (H2H)</h2>
        <div class="filter-row">
          <select id="h2hA" class="select"></select>
          <span class="h2h-vs">vs</span>
          <select id="h2hB" class="select"></select>
        </div>
        <div id="h2hResult" class="h2h-result"></div>
      </div>

      <div class="card" style="margin-top:18px">
        <h2>👥 Gracze stali <span class="badge" id="rosterBadge"></span></h2>
        <div class="roster" id="rosterList"></div>
        <div class="filter-row" style="margin-top:12px">
          <input id="rosterInput" class="select" placeholder="Imię nowego gracza" style="min-width:200px">
          <button id="btnRosterAdd" class="btn btn-gold">➕ Dodaj stałego gracza</button>
          <span class="note" id="rosterMsg"></span>
        </div>
        <p class="note">Stali gracze są zawsze widoczni w profilach i statystykach — nawet bez rozegranych meczów.</p>
      </div>
    </section>

    <section id="turnieje" class="hist-section">
      <div class="card">
        <h2>🗂️ Wszystkie turnieje</h2>
        <div class="filter-row">
          <button id="btnRecover" class="btn btn-ghost">♻️ Odzyskaj wyniki z poprzedniej wersji</button>
          <span class="note" id="recoverMsg"></span>
        </div>
        <div class="table-wrap">
          <table class="standings">
            <thead>
              <tr><th>Turniej</th><th>Gra</th><th>Data</th><th>Gracze</th><th>Mistrz</th><th>2. miejsce</th><th>3. miejsce</th><th>Status</th><th></th></tr>
            </thead>
            <tbody id="tourRows"></tbody>
          </table>
        </div>
      </div>
    </section>

  </div>
</div>

<div class="foot">GRZYBOWIT FIFA CUP · Dane: localStorage (kopia zapasowa) + opcjonalne współdzielenie online</div>

<!-- WSPÓŁDZIELONE WYNIKI (online) -->
<div id="syncOverlay" class="overlay hidden">
  <div class="modal">
    <h2>🌐 Współdzielone wyniki</h2>
    <p class="note" style="margin:0 0 14px">
      Wszyscy gracze widzą tę samą tabelę i te same wyniki. Każdy wpisuje kod <b>raz</b> — potem zmiany
      pojawiają się u wszystkich automatycznie (odświeżanie co ok. 10 s, a od razu po powrocie do karty).
    </p>

    <div id="syncStatusBox" class="sync-status">
      <span class="sync-dot off" id="syncDotBox"></span>
      <span id="syncStatusText">Brak synchronizacji — wyniki tylko w tej przeglądarce.</span>
    </div>

    <div id="syncConnected" class="hidden">
      <label class="field">Kod współdzielenia
        <input id="syncCodeOut" type="text" readonly>
      </label>
      <label class="field">Link dla znajomych
        <input id="syncLinkOut" type="text" readonly>
      </label>
      <div class="sync-actions">
        <button id="btnCopyLink" class="btn btn-gold btn-sm" type="button">🔗 Kopiuj link</button>
        <button id="btnCopyCode" class="btn btn-ghost btn-sm" type="button">📋 Kopiuj kod</button>
        <button id="btnSyncNow" class="btn btn-ghost btn-sm" type="button">🔄 Odśwież teraz</button>
        <button id="btnSyncLeave" class="btn btn-red btn-sm" type="button">⛔ Rozłącz</button>
      </div>
    </div>

    <div id="syncDisconnected">
      <div class="sync-actions">
        <button id="btnSyncCreate" class="btn btn-gold" type="button">✨ Utwórz kod i udostępnij</button>
      </div>
      <label class="field" style="margin-top:16px">…albo dołącz kodem od znajomego
        <input id="syncJoinInput" type="text" placeholder="np. fifa-turniej-ab12cd34ef56gh78">
        <span class="note">Możesz wkleić sam kod albo cały link (np. https://…/?sync=fifa-turniej-…).</span>
      </label>
      <div class="sync-actions">
        <button id="btnSyncJoin" class="btn btn-green" type="button">🔗 Dołącz</button>
      </div>
    </div>

    <p id="syncMsg" class="note"></p>
    <p id="syncError" class="err hidden"></p>
    <p class="note">
      Dane trzymamy w darmowej usłudze <b>textdb.online</b> pod losowym kodem. Kod działa jak hasło —
      kto go zna, może odczytać i zmienić wyniki, więc podawaj go tylko osobom z turnieju.
      Uwaga: usługa kasuje wpisy nieużywane przez 30 dni.
    </p>
    <div class="modal-actions">
      <button id="btnSyncClose" class="btn btn-ghost" type="button">Zamknij</button>
    </div>
  </div>
</div>

<!-- LOSOWANIE -->
<div id="drawOverlay" class="overlay hidden">
  <div class="draw-box">
    <h2 id="drawTitle">🎰 Losowanie — rewanże</h2>
    <p class="draw-hint" id="drawHint">Wylosowana kolejność meczów rewanżowych (miejscówki odwrócone)</p>
    <div id="drawCards" class="draw-cards"></div>
    <button id="btnDrawClose" class="btn btn-gold">Zamknij</button>
  </div>
</div>

<!-- NOWY TURNIEJ -->
<div id="newTourOverlay" class="overlay hidden">
  <div class="modal">
    <h2>➕ Nowy turniej</h2>
    <label class="field">Nazwa turnieju
      <input id="ntName" type="text" placeholder="np. Turniej u Maćka">
    </label>
    <label class="field">Gra
      <select id="ntGame" class="select"></select>
    </label>
    <label class="field">Data
      <input id="ntDate" type="date">
    </label>
    <div class="field">
      <span class="lbl">Gracze</span>
      <div id="ntPlayers" class="nt-players"></div>
      <button id="ntAddPlayer" class="btn btn-ghost btn-sm" type="button">+ Dodaj gracza</button>
    </div>
    <p id="ntError" class="err hidden"></p>
    <div class="modal-actions">
      <button id="ntCancel" class="btn btn-ghost" type="button">Anuluj</button>
      <button id="ntCreate" class="btn btn-gold" type="button">Utwórz turniej</button>
    </div>
  </div>
</div>

<!-- EDYCJA TURNIEJU -->
<div id="editTourOverlay" class="overlay hidden">
  <div class="modal">
    <h2>✏️ Edytuj turniej</h2>
    <label class="field">Nazwa turnieju
      <input id="etName" type="text" placeholder="Nazwa turnieju">
    </label>
    <label class="field">Gra
      <select id="etGame" class="select"></select>
    </label>
    <label class="field">Data
      <input id="etDate" type="date">
    </label>
    <div class="modal-actions">
      <button id="etCancel" class="btn btn-ghost" type="button">Anuluj</button>
      <button id="etSave" class="btn btn-gold" type="button">Zapisz zmiany</button>
    </div>
  </div>
</div>

<!-- KARTA GRACZA -->
<div id="profileOverlay" class="overlay hidden">
  <div class="draw-box profile-box">
    <div id="profileContent"></div>
    <button id="btnProfileClose" class="btn btn-gold">Zamknij</button>
  </div>
</div>

<script src="app.js"></script>
</body>
</html>
